# OpenRouter API Key for live LLM red-teaming calls
OPENROUTER_API_KEY=

# Server Port (default 3000)
PORT=3000

# Model configurations (defaults to openai/gpt-4o-mini or deepseek/deepseek-chat)
DEFAULT_MODEL_ID=openai/gpt-4o-mini
CLIENT_AGENT_MODEL_ID=openai/gpt-4o-mini
CLASSIFIER_MODEL_ID=openai/gpt-4o-mini
MUTATOR_MODEL_ID=openai/gpt-4o-mini
